{
  "name": "bare-ndk",
  "version": "0.2.1",
  "description": "Android NDK bindings and runtime for Bare",
  "exports": {
    "./package": "./package.json",
    ".": "./index.js",
    "./runtime": "./runtime.js"
  },
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "os": {
      "bare": "bare-os",
      "default": "os"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    }
  },
  "files": [
    "index.js",
    "runtime.js",
    "binding.cc",
    "binding.js",
    "CMakeLists.txt",
    "lib",
    "prebuilds"
  ],
  "workspaces": [
    "test/fixtures/*"
  ],
  "addon": true,
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "test": "brittle-bare --coverage test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/bare-ndk.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bare-ndk/issues"
  },
  "homepage": "https://github.com/holepunchto/bare-ndk#readme",
  "dependencies": {
    "require-asset": "^1.1.0"
  },
  "peerDependencies": {
    "bare-build": "^1.0.0"
  },
  "devDependencies": {
    "bare-path": "^3.0.0",
    "brittle": "^3.18.0",
    "cmake-android": "^0.1.2",
    "cmake-bare": "^1.6.5",
    "cmake-fetch": "^1.4.0",
    "lunte": "^1.8.0",
    "prettier": "^3.4.1",
    "prettier-config-holepunch": "^2.0.0"
  }
}
